<?xml version="1.0" encoding="utf-8"?>
<!-- Hozin Tools — GLOSSY: tombol MULAI dengan gradient teal + kilau atas + ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4006271F">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="28dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#00E5A0"
                        android:endColor="#00B87F"
                        android:type="linear" />
                </shape>
            </item>
            <!-- kilau kaca di setengah atas -->
            <item
                android:left="2dp"
                android:right="2dp"
                android:top="2dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="26dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#4DFFFFFF"
                        android:centerColor="#14FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
