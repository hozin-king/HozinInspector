<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema default: GLOSSY (kaca bening mengkilap) -->
    <style name="Theme.HozinTools" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/hi_accent</item>
        <item name="colorOnPrimary">#06281F</item>
        <item name="colorPrimaryContainer">@color/hi_accent_dark</item>
        <item name="colorOnPrimaryContainer">#7DFFD4</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="colorSurface">#141E2E</item>
        <item name="colorOnSurface">@color/hi_text</item>
        <!-- Pemetaan drawable kaca GLOSSY -->
        <item name="hiCardBg">@drawable/glass_card</item>
        <item name="hiBtnPrimaryBg">@drawable/btn_start_ripple</item>
        <item name="hiBtnGlassBg">@drawable/btn_glass</item>
        <item name="hiPillBg">@drawable/pill_glass</item>
        <item name="hiSearchBg">@drawable/search_bg</item>
        <item name="hiPillOk">@drawable/pill_ok</item>
        <item name="hiPillBad">@drawable/pill_bad</item>
        <item name="hiPillNeutral">@drawable/pill_neutral</item>
    </style>

    <!-- Tema MATTE (kaca doff): flat, subtle, minim kilau -->
    <style name="Theme.HozinTools.Matte" parent="Theme.HozinTools">
        <item name="hiCardBg">@drawable/card_matte</item>
        <item name="hiBtnPrimaryBg">@drawable/btn_primary_matte</item>
        <item name="hiBtnGlassBg">@drawable/btn_glass_matte</item>
        <item name="hiPillBg">@drawable/pill_glass_matte</item>
        <item name="hiSearchBg">@drawable/search_bg_matte</item>
        <item name="hiPillOk">@drawable/pill_ok_matte</item>
        <item name="hiPillBad">@drawable/pill_bad_matte</item>
        <item name="hiPillNeutral">@drawable/pill_neutral_matte</item>
    </style>

    <!-- Splash halus saat app dibuka -->
    <style name="Theme.HozinTools.Splash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>

    <!-- Kartu kaca (drawable dipilih via atribut tema -> Glossy/Matte otomatis) -->
    <style name="HiCard">
        <item name="android:background">?attr/hiCardBg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="HiAppTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="HiSectionTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="HiSectionDesc" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#B3FFFFFF</item>
    </style>

    <style name="HiBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#CCFFFFFF</item>
    </style>

    <style name="HiStatusPill" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:background">?attr/hiPillBg</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="HiButtonPrimary" parent="Widget.Material3.Button">
        <item name="android:background">?attr/hiBtnPrimaryBg</item>
        <item name="android:textColor">#06281F</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="HiButtonGlass" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">?attr/hiBtnGlassBg</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="HiSwitch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="HiSearchField">
        <item name="android:background">?attr/hiSearchBg</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#80FFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
