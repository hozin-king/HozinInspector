<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header + status -->
        <LinearLayout
            style="@style/HiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="12dp"
                        android:src="@mipmap/ic_launcher"
                        android:contentDescription="Hozin Tools" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HiAppTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hozin Tools" />

                        <TextView
                            style="@style/HiSectionDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="App inspector universal (modul LSPosed)" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvGrantStatus"
                        style="@style/HiStatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="READ_LOGS: ..."
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvModuleStatus"
                        style="@style/HiStatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MODUL: ..."
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- App target -->
        <LinearLayout
            style="@style/HiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/HiSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App target" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTarget"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="(belum dipilih)"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnPick"
                        style="@style/HiButtonGlass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Fitur tracer -->
        <LinearLayout
            style="@style/HiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/HiSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fitur tracer" />

                <CheckBox
                    android:id="@+id/cbMethod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Method tracer" />

                <CheckBox
                    android:id="@+id/cbUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="URL tracker" />

                <CheckBox
                    android:id="@+id/cbUi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UI interaction tracer" />

                <CheckBox
                    android:id="@+id/cbPref"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pref access tracer" />

                <CheckBox
                    android:id="@+id/cbDump"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dump layout (on-demand)" />

                <CheckBox
                    android:id="@+id/cbRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:checked="true"
                    android:text="Batasi log 50/detik (anti-lag)" />

                <CheckBox
                    android:id="@+id/cbLogArgs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:checked="true"
                    android:text="Log argumen &amp; return value" />

                <TextView
                    style="@style/HiSectionDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Argumen/return bikin log lebih ramai — matikan bila lag." />

                <TextView
                    style="@style/HiSectionDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Rate limit mencegah target freeze saat method ramai dipanggil." />
            </LinearLayout>
        </LinearLayout>

        <!-- Filter prefix -->
        <LinearLayout
            style="@style/HiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/HiSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter class prefix" />

                <TextView
                    style="@style/HiSectionDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Opsional — hook semua class yang diawali prefix ini." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etPrefix"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="cth: com.contoh.app."
                        android:inputType="text"
                        android:fontFamily="monospace"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnAdd"
                        style="@style/HiButtonGlass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tambah" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPrefixes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="(kosong)"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDelLast"
                        style="@style/HiButtonGlass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hapus terakhir" />

                    <Button
                        android:id="@+id/btnDelAll"
                        style="@style/HiButtonGlass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Hapus semua" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Hook class exact -->
        <LinearLayout
            style="@style/HiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/HiSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hook class (pilihan exact)" />

                <TextView
                    style="@style/HiSectionDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pilih class spesifik dari daftar semua class di APK target." />

                <TextView
                    android:id="@+id/tvHookClasses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 class dipilih"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvHookWarn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="⚠ &gt;20 class: kebanyakan hook bisa bikin target lag/FC/ANR."
                    android:textColor="@color/hi_red"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnPickClass"
                    style="@style/HiButtonGlass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="PILIH CLASS" />

                <TextView
                    android:id="@+id/tvClassSummary"
                    style="@style/HiSectionDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>

        <!-- Aksi -->
        <Button
            style="@style/HiButtonPrimary"
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SIMPAN CONFIG" />

        <Button
            android:id="@+id/btnGrant"
            style="@style/HiButtonGlass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="GRANT READ_LOGS (root)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLog"
                style="@style/HiButtonGlass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lihat Log" />

            <Button
                android:id="@+id/btnManifest"
                style="@style/HiButtonGlass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Lihat Manifest" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRootTools"
            style="@style/HiButtonGlass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ROOT TOOLS (butuh root)" />

        <Button
            android:id="@+id/btnWebScraper"
            style="@style/HiButtonGlass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="WEB SCRAPER" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="monospace"
            android:text=""
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
