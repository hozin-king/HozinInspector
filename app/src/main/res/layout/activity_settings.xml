<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/HiAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengaturan" />

        <TextView
            style="@style/HiSectionDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Personalisasi tampilan Hozin Tools" />

        <!-- Tema kaca -->
        <LinearLayout
            style="@style/HiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/HiSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tema Kaca" />

                <TextView
                    style="@style/HiSectionDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Berlaku ke semua layar. Pilihan tersimpan otomatis." />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/tgTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeGlossy"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Glossy" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeMatte"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Matte" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    style="@style/HiSectionDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Glossy: kaca bening mengkilap (default)." />

                <TextView
                    style="@style/HiSectionDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Matte: kaca doff — flat dan minim kilau." />
            </LinearLayout>
        </LinearLayout>

        <!-- Tentang -->
        <LinearLayout
            style="@style/HiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/HiSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tentang" />

                <TextView
                    android:id="@+id/tvAboutVer"
                    style="@style/HiBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Hozin Tools" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
