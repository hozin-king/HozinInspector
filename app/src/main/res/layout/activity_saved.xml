<?xml version="1.0" encoding="utf-8"?>
<!-- Hozin Tools — Layar daftar artikel tersimpan (SavedActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        style="@style/HiCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            style="@style/HiAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tersimpan" />

        <TextView
            style="@style/HiSectionDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Artikel yang kamu simpan untuk dibaca offline." />
    </LinearLayout>

    <!-- Hapus semua -->
    <Button
        android:id="@+id/btnClearAll"
        style="@style/HiButtonGlass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="HAPUS SEMUA" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvSavedEmpty"
        style="@style/HiSectionDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="Belum ada artikel tersimpan."
        android:visibility="gone" />

    <!-- Daftar -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSaved"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
