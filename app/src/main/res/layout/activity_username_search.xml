<?xml version="1.0" encoding="utf-8"?>
<!-- Hozin Tools — Username Search (OSINT, data Sherlock Project) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header -->
        <LinearLayout
            style="@style/HiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/HiAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username Search" />

            <TextView
                style="@style/HiSectionDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cek keberadaan username di puluhan situs (data: Sherlock Project, MIT)." />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Data situs: Sherlock Project (MIT)"
                android:textColor="#80FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Input username -->
        <LinearLayout
            style="@style/HiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/HiSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username" />

            <EditText
                android:id="@+id/etUsername"
                style="@style/HiSearchField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="mis. hozinking"
                android:inputType="text"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCheck"
                    style="@style/HiButtonPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="CEK" />

                <Button
                    android:id="@+id/btnCancel"
                    style="@style/HiButtonGlass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="BATAL"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressScan"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:progressTint="@color/hi_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvProgressStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text=""
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Hasil -->
        <LinearLayout
            android:id="@+id/cardResults"
            style="@style/HiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvResultSummary"
                style="@style/HiSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Belum ada hasil." />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSites"
                android:layout_width="match_parent"
                android:layout_height="480dp"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
