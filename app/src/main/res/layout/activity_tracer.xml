<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Judul halaman Tracer -->
        <LinearLayout
            style="@style/HiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_tool_tracer"
                    android:tint="@color/hi_accent"
                    android:contentDescription="Tracer" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/HiAppTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tracer" />

                    <TextView
                        style="@style/HiSectionDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Konfigurasi hook &amp; tracing app target" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- App target -->
        <LinearLayout
            style="@style/HiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/HiSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App target" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTarget"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="(belum dipilih)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnPick"
                        style="@style/HiButtonGlass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Pengaturan Tracer: SATU kartu expandable berisi SEMUA config tracer -->
        <LinearLayout
            android:id="@+id/cardTracer"
            style="@style/HiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/tracerHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/HiSectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pengaturan Tracer" />

                    <TextView
                        style="@style/HiSectionDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Toggle tracer, filter prefix, hook class — tap untuk buka/tutup" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivTracerChevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="#B3FFFFFF"
                    android:contentDescription="Buka/tutup" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tracerBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- (1) 7 toggle tracer -->
                <TextView
                    style="@style/HiSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Fitur tracer" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/cbMethod"
                    style="@style/HiSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Method tracer" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/cbUrl"
                    style="@style/HiSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="URL tracker" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/cbUi"
                    style="@style/HiSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="UI interaction tracer" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/cbPref"
                    style="@style/HiSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pref access tracer" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/cbDump"
                    style="@style/HiSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dump layout (on-demand)" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/cbRate"
                    style="@style/HiSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Batasi log 50/detik (anti-lag)" />

                <TextView
                    style="@style/HiSectionDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rate limit mencegah target freeze saat method ramai dipanggil." />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/cbLogArgs"
                    style="@style/HiSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Log argumen &amp; return value" />

                <TextView
                    style="@style/HiSectionDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Argumen/return bikin log lebih ramai — matikan bila lag." />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#1FFFFFFF" />

                <!-- (2) Filter class prefix -->
                <TextView
                    style="@style/HiSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter class prefix" />

                <TextView
                    style="@style/HiSectionDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Opsional — hook semua class yang diawali prefix ini." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etPrefix"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="cth: com.contoh.app."
                        android:inputType="text"
                        android:fontFamily="monospace"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#80FFFFFF"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnAdd"
                        style="@style/HiButtonGlass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tambah" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPrefixes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="(kosong)"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDelLast"
                        style="@style/HiButtonGlass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hapus terakhir" />

                    <Button
                        android:id="@+id/btnDelAll"
                        style="@style/HiButtonGlass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Hapus semua" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#1FFFFFFF" />

                <!-- (3) Hook class exact -->
                <TextView
                    style="@style/HiSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hook class (pilihan exact)" />

                <TextView
                    style="@style/HiSectionDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pilih class spesifik dari daftar semua class di APK target." />

                <TextView
                    android:id="@+id/tvHookClasses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 class dipilih"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvHookWarn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="⚠ &gt;20 class: kebanyakan hook bisa bikin target lag/FC/ANR."
                    android:textColor="@color/hi_red"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnPickClass"
                    style="@style/HiButtonGlass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="PILIH CLASS" />

                <TextView
                    android:id="@+id/tvClassSummary"
                    style="@style/HiSectionDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="" />

                <!-- (4) Simpan config (di dalam kartu) -->
                <Button
                    android:id="@+id/btnSaveInner"
                    style="@style/HiButtonGlass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:text="SIMPAN CONFIG" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tombol besar MULAI TRACING dengan glow -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="-6dp"
                android:background="@drawable/btn_start_glow" />

            <Button
                android:id="@+id/btnSave"
                style="@style/HiButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MULAI TRACING" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="monospace"
            android:text=""
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
