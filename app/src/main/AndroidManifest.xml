<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.HozinInspector"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.LogViewerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ManifestActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ClassPickerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.MethodListActivity"
            android:exported="false" />

        <!-- LSPosed / Xposed module declaration -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="App inspector universal: method tracer, URL tracker, UI interaction tracer, pref access tracer, manifest &amp; layout viewer." />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
    </application>

</manifest>
