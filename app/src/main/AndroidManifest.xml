<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.HozinTools"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.MainActivity"
            android:theme="@style/Theme.HozinTools.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.LogViewerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ManifestActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ClassPickerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.MethodListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AppPickerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.RootToolsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.PrefViewerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.DbViewerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.FileExplorerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.MapsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.WebScraperActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ReaderActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ImageViewerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SavedActivity"
            android:exported="false" />
        <activity
            android:name=".ui.UsernameSearchActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <!-- FileProvider untuk share hasil export JSON -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.hozinking.appinspector.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- LSPosed / Xposed module declaration -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Hozin Tools — app inspector universal: method tracer, URL tracker, UI interaction tracer, pref access tracer, manifest &amp; layout viewer, root tools." />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
    </application>

</manifest>
